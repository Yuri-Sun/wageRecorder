/**app.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 通用容器 */
.page-container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

/* 按钮样式 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  letter-spacing: 2rpx;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  background: transparent;
  color: #07C160;
  font-size: 28rpx;
  border: 2rpx solid #07C160;
  border-radius: 36rpx;
}

.btn-outline:active {
  background: rgba(7, 193, 96, 0.06);
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  background: #FA5151;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: none;
  padding: 0 32rpx;
}

.btn-danger:active {
  opacity: 0.85;
}

.btn-small {
  height: 56rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

/* 数值大字 */
.value-large {
  font-size: 56rpx;
  font-weight: 700;
  color: #333333;
}

.value-medium {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.text-green {
  color: #07C160;
}

.text-orange {
  color: #FF9500;
}

.text-gray {
  color: #999999;
}

.text-small {
  font-size: 24rpx;
}

/* Flex 布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  color: #CCCCCC;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-green {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.tag-blue {
  background: rgba(16, 174, 255, 0.1);
  color: #10AEFF;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  gap: 16rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #F5F5F5;
  color: #666666;
}

.filter-item.active {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  font-weight: 500;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 600rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-actions .btn-outline,
.modal-actions .btn-primary {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

/* 输入框 */
.input-field {
  width: 100%;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* Toast */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.75);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  z-index: 2000;
}
