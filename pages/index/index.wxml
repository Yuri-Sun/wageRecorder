<!--pages/index/index.wxml-->
<navigation-bar title="考勤打卡" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="index-scroll ui-scroll" scroll-y>
  <view class="ui-page">

    <view class="ui-section">
      <view class="ui-group ui-clock-hero">
        <text class="ui-clock-date text-nowrap">{{dateText}}</text>
        <text class="ui-clock-time text-nowrap">{{timeText}}</text>
        <text class="ui-clock-weekday text-nowrap">{{weekday}}</text>
      </view>
    </view>

    <view class="ui-section">
      <text class="ui-section-title">今日概览</text>
      <view class="ui-group ui-stats-grid">
        <view class="ui-stat-item">
          <text class="ui-stat-value">{{todayWork.duration}}</text>
          <text class="ui-stat-label">工时(h)</text>
        </view>
        <view class="ui-stat-item">
          <text class="ui-stat-value ui-stat-value--accent">A${{todayWork.wage}}</text>
          <text class="ui-stat-label">预估工资</text>
        </view>
        <view class="ui-stat-item">
          <text class="ui-stat-value">{{todayPunchCount}}</text>
          <text class="ui-stat-label">打卡次数</text>
        </view>
      </view>
      <text class="ui-section-footnote">时薪 A${{hourlyRate}}/小时</text>
    </view>

    <view class="ui-section">
      <text class="ui-section-title">打卡</text>
      <view class="ui-group ui-punch-panel">
        <view wx:if="{{punchState === 'off'}}">
          <view class="ui-punch-hint">点击下方按钮开始上班打卡</view>
        </view>
        <view wx:elif="{{punchState === 'on'}}">
          <view class="ui-punch-hint text-nowrap">已上班 {{startTime}}，请下班打卡</view>
          <view class="ui-live-box">
            <view class="ui-live-label">当前预估工资</view>
            <view class="ui-live-amount text-nowrap">A${{liveWage}}</view>
            <view class="ui-live-sub text-nowrap">已工作 {{liveDuration}} 小时</view>
          </view>
          <view class="meal-check" bindtap="toggleDeductMeal">
            <view class="meal-checkbox {{deductMeal ? 'checked' : ''}}">
              <text wx:if="{{deductMeal}}">√</text>
            </view>
            <text class="meal-label text-nowrap">扣除午饭半小时</text>
          </view>
        </view>
        <view wx:else>
          <view class="ui-punch-hint">今日已有打卡记录，可继续添加</view>
        </view>

        <view class="punch-buttons">
          <button class="btn-primary punch-btn" wx:if="{{punchState === 'off'}}" bindtap="handlePunchIn">上班打卡</button>
          <button class="btn-primary punch-btn punch-btn-out" wx:elif="{{punchState === 'on'}}" bindtap="handlePunchOut">下班打卡</button>
          <view class="punch-buttons-row" wx:else>
            <button class="btn-outline punch-btn-half" bindtap="handlePunchIn">继续上班</button>
            <button class="btn-primary punch-btn-half" bindtap="handlePunchIn">快速打卡</button>
          </view>
        </view>
      </view>
    </view>

    <view class="ui-section">
      <view class="ui-section-header">
        <text class="ui-section-title ui-section-title--inline">最近记录</text>
        <text class="ui-link" bindtap="goToRecords">全部 ›</text>
      </view>
      <view class="ui-group" wx:if="{{recentRecords.length > 0}}">
        <view class="ui-cell ui-cell--record {{index === recentRecords.length - 1 ? 'ui-cell--last' : ''}}" wx:for="{{recentRecords}}" wx:key="id" wx:for-index="index">
          <view class="ui-cell__body">
            <text class="ui-cell__title text-nowrap">{{item.date}}</text>
            <text class="ui-cell__desc text-nowrap">{{item.startTime}} - {{item.endTime}}</text>
          </view>
          <text class="ui-cell__extra text-nowrap">A${{item.wage}}</text>
        </view>
      </view>
      <view class="ui-group" wx:else>
        <view class="ui-empty">
          <text class="ui-empty-text">暂无打卡记录</text>
        </view>
      </view>
    </view>

    <view class="index-version">
      <text>考勤薪资记录 v3.0.1</text>
    </view>

  </view>
</scroll-view>
