/**pages/index/index.wxss**/
@import '../../styles/ui-kit.wxss';

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

.index-scroll {
  flex: 1;
  height: 0;
}

.ui-cell--record {
  min-height: 100rpx;
}

.punch-buttons {
  margin-top: 8rpx;
}

.punch-buttons-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.punch-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  border-radius: 48rpx;
}

.punch-btn-half {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.punch-btn-out {
  background: linear-gradient(135deg, #ff9500, #ff7a00) !important;
}

.meal-check {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.meal-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 3rpx solid #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.meal-checkbox.checked {
  background: #ff9500;
  border-color: #ff9500;
}

.meal-label {
  font-size: 26rpx;
  color: #666666;
  white-space: nowrap;
}
