/**pages/record/record.wxss**/
@import '../../styles/ui-kit.wxss';

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

.record-scroll {
  flex: 1;
  height: 0;
}

.ui-cell--record {
  align-items: flex-start;
  min-height: 120rpx;
}

.record-cell-main {
  padding-right: 16rpx;
}

.record-cell-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  gap: 12rpx;
}

.record-wage {
  font-size: 32rpx;
  font-weight: 700;
  color: #07c160;
}

.record-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.record-action {
  font-size: 26rpx;
  white-space: nowrap;
}

.record-action--edit {
  color: #10aeff;
}

.record-action--del {
  color: #fa5151;
}

.record-modal {
  width: 640rpx;
  padding: 36rpx 32rpx 32rpx;
}

.record-modal-group {
  margin-bottom: 24rpx;
  padding: 8rpx 0;
}

.record-form-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 16rpx 24rpx;
}

.record-form-col {
  flex: 1;
  min-width: 0;
}

.record-form-block {
  padding: 12rpx 24rpx 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.record-form-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.record-form-picker {
  height: 72rpx;
  line-height: 72rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #333333;
}

.record-form-input {
  height: 72rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.record-meal-check {
  justify-content: flex-start;
  padding: 16rpx 24rpx 8rpx;
  margin-bottom: 0;
}

.record-preview {
  padding: 12rpx 24rpx 20rpx;
  font-size: 26rpx;
  color: #07c160;
  text-align: center;
}

.meal-check {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meal-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 3rpx solid #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.meal-checkbox.checked {
  background: #ff9500;
  border-color: #ff9500;
}

.meal-label {
  font-size: 26rpx;
  color: #666666;
}
