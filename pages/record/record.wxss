/**pages/record/record.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}

.scrollarea {
  flex: 1;
}

.summary-bar {
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.record-card {
  padding: 24rpx 32rpx;
}

.record-card-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.record-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.record-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.record-time {
  font-size: 24rpx;
  color: #10AEFF;
  padding: 4rpx 12rpx;
  background: rgba(16, 174, 255, 0.1);
  border-radius: 8rpx;
}

.record-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 24rpx;
}

.record-edit {
  font-size: 26rpx;
  color: #10AEFF;
  padding: 8rpx 0;
}

.record-delete {
  font-size: 26rpx;
  color: #FA5151;
  padding: 8rpx 0;
}

.record-card-bottom {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx 32rpx;
}

.record-metric {
  font-size: 26rpx;
  color: #666666;
}

.metric-value {
  font-weight: 600;
}

.record-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
  padding: 8rpx 16rpx;
  background: #F9F9F9;
  border-radius: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.edit-preview-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx 24rpx;
  margin-top: 16rpx;
}

/* 吃饭扣除勾选 */
.meal-check {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.meal-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 3rpx solid #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.meal-checkbox.checked {
  background: #FF9500;
  border-color: #FF9500;
}

.meal-label {
  font-size: 26rpx;
  color: #666666;
}
