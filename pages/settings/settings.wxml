<!--pages/settings/settings.wxml-->
<navigation-bar title="设置" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="settings-scroll ui-scroll" scroll-y>
  <view class="ui-page">

    <view class="ui-section">
      <text class="ui-section-title">时薪</text>
      <view class="ui-group">
        <view class="ui-cell settings-cell--form">
          <view class="ui-cell__body">
            <text class="ui-cell__title">默认时薪</text>
            <text class="ui-cell__desc">澳元 / 小时，保存后重算全部工资</text>
          </view>
          <view class="settings-rate-box">
            <text class="settings-rate-currency text-nowrap">A$</text>
            <input
              class="settings-rate-input"
              type="digit"
              value="{{rateInputValue}}"
              bindinput="onRateInput"
              bindblur="onRateBlur"
            />
          </view>
        </view>
        <view class="settings-group-footer" wx:if="{{rateChanged}}">
          <text class="settings-tip settings-tip--warn">有未保存的修改</text>
          <button class="settings-inline-btn" bindtap="saveRate">保存时薪</button>
        </view>
      </view>
    </view>

    <view class="ui-section">
      <text class="ui-section-title">数据概览</text>
      <view class="ui-group ui-stats-grid">
        <view class="ui-stat-item">
          <text class="ui-stat-value">{{totalRecords}}</text>
          <text class="ui-stat-label">打卡记录</text>
        </view>
        <view class="ui-stat-item">
          <text class="ui-stat-value">{{totalDuration}}</text>
          <text class="ui-stat-label">总工时(h)</text>
        </view>
        <view class="ui-stat-item">
          <text class="ui-stat-value ui-stat-value--accent">A${{totalWage}}</text>
          <text class="ui-stat-label">总工资</text>
        </view>
      </view>
    </view>

    <view class="ui-section">
      <text class="ui-section-title">导出</text>
      <view class="ui-group settings-export-range">
        <view class="settings-range-row">
          <text class="settings-range-label">开始日期</text>
          <picker class="settings-range-picker-wrap" mode="date" value="{{exportStartDate}}" end="{{maxDate}}" bindchange="onExportStartChange">
            <view class="settings-range-picker">
              <text class="settings-range-value text-nowrap">{{exportStartDate}}</text>
              <text class="ui-cell__chevron">›</text>
            </view>
          </picker>
        </view>
        <view class="settings-range-row">
          <text class="settings-range-label">结束日期</text>
          <picker
            class="settings-range-picker-wrap"
            mode="date"
            value="{{exportEndDate}}"
            end="{{maxDate}}"
            bindchange="onExportEndChange"
          >
            <view class="settings-range-picker">
              <text class="settings-range-value text-nowrap">{{exportEndDate}}</text>
              <text class="ui-cell__chevron">›</text>
            </view>
          </picker>
        </view>
        <view class="settings-range-presets">
          <text class="settings-preset" bindtap="setExportPreset" data-preset="week">本周</text>
          <text class="settings-preset" bindtap="setExportPreset" data-preset="month">本月</text>
          <text class="settings-preset" bindtap="setExportPreset" data-preset="all">全部</text>
        </view>
        <text class="settings-range-count">将导出 {{exportRecordCount}} 条记录</text>
      </view>
      <view class="ui-group">
        <view class="ui-cell settings-cell--link" bindtap="exportCSV">
          <view class="settings-cell__icon settings-cell__icon--green">表</view>
          <view class="ui-cell__body">
            <text class="ui-cell__title">导出表格</text>
            <text class="ui-cell__desc">CSV，可用 Excel 打开</text>
          </view>
          <text class="ui-cell__chevron">›</text>
        </view>
        <view class="ui-cell settings-cell--link ui-cell--last" bindtap="exportTXT">
          <view class="settings-cell__icon settings-cell__icon--blue">文</view>
          <view class="ui-cell__body">
            <text class="ui-cell__title">导出文本</text>
            <text class="ui-cell__desc">适合微信聊天阅读与转发</text>
          </view>
          <text class="ui-cell__chevron">›</text>
        </view>
      </view>
      <text class="ui-section-footnote">按上方时间范围导出，可分享到微信聊天</text>
    </view>

    <view class="ui-section">
      <view class="ui-group">
        <view class="ui-cell settings-cell--danger" bindtap="clearAllData">
          <text class="settings-danger-text">清空所有数据</text>
        </view>
      </view>
      <text class="ui-section-footnote">不可恢复，请谨慎操作</text>
    </view>

    <view class="settings-version">
      <text>考勤薪资记录 v3.0.1</text>
    </view>

  </view>
</scroll-view>
