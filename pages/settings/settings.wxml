<!--pages/settings/settings.wxml-->
<navigation-bar title="设置" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page-container">

    <!-- 时薪设置 -->
    <view class="card">
      <view class="card-title">时薪设置</view>
      <view class="flex-between">
        <view class="flex-row" style="gap: 8rpx;">
          <text class="rate-label">每小时工资</text>
          <text class="text-small text-gray">（元/小时）</text>
        </view>
        <view class="flex-row rate-input-group">
          <text class="rate-symbol">$</text>
          <input class="rate-input" type="digit" value="{{hourlyRate}}" bindinput="onRateInput" bindblur="onRateBlur" />
        </view>
      </view>
      <view class="rate-hint" wx:if="{{rateChanged}}">
        <text class="text-orange">已修改，点击下方保存按钮生效</text>
      </view>
      <button class="btn-primary" wx:if="{{rateChanged}}" bindtap="saveRate" style="margin-top: 24rpx;">
        保存时薪
      </button>
      <view class="rate-preview" wx:if="{{!rateChanged}}">
        <text class="text-small text-gray">修改后自动保存并重新计算所有工资</text>
      </view>
    </view>

    <!-- 数据统计 -->
    <view class="card">
      <view class="card-title">数据概览</view>
      <view class="flex-between" style="margin-bottom: 20rpx;">
        <text class="text-small text-gray">总打卡记录</text>
        <text class="stat-num">{{totalRecords}} 条</text>
      </view>
      <view class="flex-between" style="margin-bottom: 20rpx;">
        <text class="text-small text-gray">总工时</text>
        <text class="stat-num">{{totalDuration}} 小时</text>
      </view>
      <view class="flex-between">
        <text class="text-small text-gray">总工资</text>
        <text class="stat-num text-green">${{totalWage}}</text>
      </view>
    </view>

    <!-- 导出功能 -->
    <view class="card">
      <view class="card-title">导出记录</view>
      <view class="export-options">
        <button class="btn-primary export-btn" bindtap="exportCSV">
          <text class="export-icon">📄</text>
          导出 CSV
        </button>
        <button class="btn-outline export-btn" bindtap="exportTXT">
          <text class="export-icon">📝</text>
          导出 TXT
        </button>
      </view>
      <view class="export-tip text-small text-gray">
        支持导出全部打卡记录，可在微信中打开或分享给好友
      </view>
    </view>

    <!-- 清空数据 -->
    <view class="card">
      <view class="card-title">数据管理</view>
      <button class="btn-danger" bindtap="clearAllData">清空所有数据</button>
      <view class="text-small text-gray" style="margin-top: 16rpx; text-align: center;">
        此操作不可恢复，请谨慎使用
      </view>
    </view>

    <!-- 版本信息 -->
    <view class="version-info">
      <text class="text-small text-gray">考勤薪资记录 v1.0.0</text>
    </view>

  </view>
</scroll-view>
