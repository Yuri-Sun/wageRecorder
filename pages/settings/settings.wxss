/**pages/settings/settings.wxss**/
/* 参考微信设计指南 + WeUI Cells：分组标题 + 白底列表组 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

.settings-scroll {
  flex: 1;
  height: 0;
}

.settings-page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 分区标题（组外，浅灰底上） */
.settings-section {
  margin-bottom: 32rpx;
}

.settings-section-title {
  display: block;
  padding: 0 16rpx 12rpx;
  font-size: 26rpx;
  color: #888888;
  font-weight: 500;
}

.settings-section-footnote {
  display: block;
  padding: 12rpx 16rpx 0;
  font-size: 24rpx;
  color: #b2b2b2;
  line-height: 1.5;
}

.settings-section--danger {
  margin-top: 16rpx;
}

/* 白底圆角分组（类似 WeUI cells） */
.settings-group {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.settings-group-footer {
  padding: 20rpx 32rpx 28rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.settings-tip {
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.settings-tip--warn {
  color: #ff9500;
}

.settings-inline-btn {
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  padding: 0;
}

.settings-inline-btn::after {
  border: none;
}

/* 列表行 */
.settings-cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 112rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f0f0f0;
}

.settings-cell--last,
.settings-cell--form {
  border-bottom: none;
}

.settings-cell--form {
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.settings-cell__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.settings-cell__body--flex {
  flex: 1;
}

.settings-cell__title {
  font-size: 32rpx;
  color: #191919;
  font-weight: 500;
  line-height: 1.35;
}

.settings-cell__desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
}

.settings-cell__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.settings-cell__icon--green {
  background: linear-gradient(135deg, #07c160, #06ad56);
}

.settings-cell__icon--blue {
  background: linear-gradient(135deg, #10aeff, #0e9de6);
}

.settings-cell__chevron {
  font-size: 36rpx;
  color: #c7c7cc;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 8rpx;
  line-height: 1;
}

.settings-cell--link:active {
  background: #f7f7f7;
}

/* 时薪输入 */
.settings-rate-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  min-width: 200rpx;
}

.settings-rate-currency {
  font-size: 32rpx;
  font-weight: 600;
  color: #07c160;
  margin-right: 8rpx;
}

.settings-rate-input {
  flex: 1;
  min-width: 80rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #191919;
  text-align: right;
  height: 48rpx;
}

/* 三列数据概览 */
.settings-stats-grid {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 32rpx 16rpx;
}

.settings-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
}

.settings-stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: #f0f0f0;
}

.settings-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #191919;
  line-height: 1.2;
  white-space: nowrap;
}

.settings-stat-value--accent {
  color: #07c160;
  font-size: 34rpx;
}

.settings-stat-label {
  font-size: 22rpx;
  color: #999999;
  white-space: nowrap;
}

/* 危险操作 */
.settings-cell--danger {
  justify-content: center;
  border-bottom: none;
  min-height: 96rpx;
  padding: 28rpx 32rpx;
}

.settings-cell--danger:active {
  background: #f7f7f7;
}

.settings-danger-text {
  font-size: 32rpx;
  color: #fa5151;
  font-weight: 500;
}

.settings-version {
  text-align: center;
  padding: 24rpx 0 16rpx;
  font-size: 24rpx;
  color: #b2b2b2;
}
