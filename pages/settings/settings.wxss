/**pages/settings/settings.wxss**/
@import '../../styles/ui-kit.wxss';

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

.settings-scroll {
  flex: 1;
  height: 0;
}

.settings-group-footer {
  padding: 20rpx 32rpx 28rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.settings-tip {
  font-size: 24rpx;
  text-align: center;
  line-height: 1.5;
}

.settings-tip--warn {
  color: #ff9500;
}

.settings-inline-btn {
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  padding: 0;
}

.settings-inline-btn::after {
  border: none;
}

.settings-rate-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  min-width: 200rpx;
}

.settings-rate-currency {
  font-size: 32rpx;
  font-weight: 600;
  color: #07c160;
  margin-right: 8rpx;
}

.settings-rate-input {
  flex: 1;
  min-width: 80rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #191919;
  text-align: right;
  height: 48rpx;
}

.settings-cell--form {
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: none;
}

.settings-cell__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.settings-cell__icon--green {
  background: linear-gradient(135deg, #07c160, #06ad56);
}

.settings-cell__icon--blue {
  background: linear-gradient(135deg, #10aeff, #0e9de6);
}

.settings-cell--link .ui-cell__body {
  flex: 1;
}

.settings-cell--danger {
  justify-content: center;
  border-bottom: none;
  min-height: 96rpx;
}

.settings-danger-text {
  font-size: 32rpx;
  color: #fa5151;
  font-weight: 500;
}

.settings-version {
  text-align: center;
  padding: 24rpx 0 16rpx;
  font-size: 24rpx;
  color: #b2b2b2;
}
