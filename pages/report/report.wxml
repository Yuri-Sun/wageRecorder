<!--pages/report/report.wxml-->
<navigation-bar title="统计报表" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<view class="ui-segment-bar">
  <view class="ui-segment-item {{viewMode === 'day' ? 'ui-segment-item--active' : ''}}" bindtap="switchMode" data-mode="day">按天</view>
  <view class="ui-segment-item {{viewMode === 'week' ? 'ui-segment-item--active' : ''}}" bindtap="switchMode" data-mode="week">按周</view>
  <view class="ui-segment-item {{viewMode === 'month' ? 'ui-segment-item--active' : ''}}" bindtap="switchMode" data-mode="month">按月</view>
</view>

<scroll-view class="report-scroll ui-scroll" scroll-y>
  <view class="ui-page">

    <block wx:if="{{stats.length > 0}}">
      <view class="ui-section">
        <view class="ui-group ui-hero-card">
          <text class="ui-hero-title text-nowrap">{{periodLabel}} · 工资总览</text>
          <text class="ui-hero-amount text-nowrap">A${{overview.totalWage}}</text>
          <view class="ui-hero-metrics">
            <view class="ui-hero-metric">
              <text class="ui-hero-metric-label">总工时</text>
              <text class="ui-hero-metric-value text-nowrap">{{overview.totalDuration}}h</text>
            </view>
            <view class="ui-hero-metric">
              <text class="ui-hero-metric-label">记录</text>
              <text class="ui-hero-metric-value text-nowrap">{{overview.totalCount}}条</text>
            </view>
            <view class="ui-hero-metric">
              <text class="ui-hero-metric-label">均值</text>
              <text class="ui-hero-metric-value text-nowrap">A${{overview.avgWage}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="ui-section">
        <text class="ui-section-title">工资趋势</text>
        <view class="ui-group report-chart-box">
          <wage-chart stats="{{stats}}" avg-wage="{{overview.avgWage}}" />
        </view>
        <text class="ui-section-footnote">基于 ECharts，点击柱子可查看详情</text>
      </view>

      <view class="ui-section">
        <text class="ui-section-title">工资明细表</text>
        <view class="ui-group">
          <view class="ui-table">
            <view class="ui-table-head">
              <text class="ui-table-col ui-table-col--period">周期</text>
              <text class="ui-table-col ui-table-col--num">工时</text>
              <text class="ui-table-col ui-table-col--num">条数</text>
              <text class="ui-table-col ui-table-col--wage">工资</text>
            </view>
            <view class="ui-table-row" wx:for="{{stats}}" wx:key="label">
              <text class="ui-table-col ui-table-col--period">{{item.label}}</text>
              <text class="ui-table-col ui-table-col--num">{{item.duration}}h</text>
              <text class="ui-table-col ui-table-col--num">{{item.count}}</text>
              <text class="ui-table-col ui-table-col--wage">A${{item.wage}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="ui-section" wx:else>
      <view class="ui-group">
        <view class="ui-empty">
          <view class="ui-empty-icon">📊</view>
          <text class="ui-empty-text">暂无统计数据</text>
          <text class="ui-section-footnote" style="padding-top: 8rpx;">去首页打卡后自动生成报表</text>
        </view>
      </view>
    </view>

  </view>
</scroll-view>
