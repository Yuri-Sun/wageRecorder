<!--pages/report/report.wxml-->
<navigation-bar title="统计报表" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<view class="filter-bar">
  <view class="filter-item {{viewMode === 'day' ? 'active' : ''}}" bindtap="switchMode" data-mode="day">按天</view>
  <view class="filter-item {{viewMode === 'week' ? 'active' : ''}}" bindtap="switchMode" data-mode="week">按周</view>
  <view class="filter-item {{viewMode === 'month' ? 'active' : ''}}" bindtap="switchMode" data-mode="month">按月</view>
</view>

<view class="date-bar" wx:if="{{viewMode === 'day' || viewMode === 'week'}}">
  <picker mode="date" value="{{anchorDate}}" end="{{maxDate}}" bindchange="onAnchorDateChange">
    <view class="date-picker-row">
      <text class="date-picker-hint">{{viewMode === 'day' ? '查看日期' : '查看周（选任意一天）'}}</text>
      <text class="date-picker-value">{{anchorDate}}</text>
      <text class="date-picker-chevron">›</text>
    </view>
  </picker>
  <text class="week-range-hint" wx:if="{{weekRangeLabel}}">当周 {{weekRangeLabel}}</text>
</view>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page-container">

    <view class="card overview-card">
      <view class="overview-title">{{periodLabel}} 工资总览</view>
      <view class="overview-amount">A${{overview.totalWage}}</view>
      <view class="flex-row" style="gap: 48rpx; margin-top: 24rpx;">
        <view>
          <text class="text-small text-gray">总工时</text>
          <text class="overview-sub">{{overview.totalDuration}} 小时</text>
        </view>
        <view>
          <text class="text-small text-gray">记录数</text>
          <text class="overview-sub">{{overview.totalCount}} 条</text>
        </view>
        <view>
          <text class="text-small text-gray">{{viewMode === 'month' ? '月均工资' : '日均工资'}}</text>
          <text class="overview-sub">A${{overview.avgWage}}</text>
        </view>
      </view>
    </view>

    <view class="card chart-card chart-{{viewMode}}" wx:if="{{stats.length > 0}}">
      <view class="card-title">工资分布</view>
      <scroll-view
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        class="chart-scroll"
        style="height: {{chartScrollHeight}}rpx;"
      >
        <view class="chart-container">
          <view class="bar-group" wx:for="{{stats}}" wx:key="keyId">
            <view class="bar-plot" style="height: {{chartPlotHeight}}rpx;">
              <text class="bar-value">A${{item.wage}}</text>
              <view
                class="bar"
                style="height: {{item.barHeight}}rpx; background: {{item.wage >= overview.avgWage * 1.2 ? '#07C160' : '#91E0B6'}};"
              ></view>
            </view>
            <text class="bar-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="card detail-card" wx:if="{{stats.length > 0}}">
      <view class="card-title">详细数据</view>
      <view class="stat-list-item flex-between" wx:for="{{stats}}" wx:key="keyId">
        <view>
          <text class="stat-list-label">{{item.date || item.month || item.label}}</text>
          <text class="stat-list-detail text-small text-gray">{{item.duration}}h · {{item.count}}条记录</text>
        </view>
        <text class="stat-list-wage">A${{item.wage}}</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{stats.length === 0}}">
      <view class="empty-icon">📊</view>
      <view class="empty-text">暂无统计数据</view>
      <view class="text-small text-gray empty-hint">切换日期或去首页打卡后查看</view>
    </view>

  </view>
</scroll-view>
