/**pages/report/report.wxss**/
@import '../../styles/ui-kit.wxss';

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

.report-scroll {
  flex: 1;
  height: 0;
}

.report-date-bar {
  background: #fff;
  padding: 16rpx 32rpx 12rpx;
  border-bottom: 1rpx solid #e6e6e6;
  flex-shrink: 0;
}

.report-date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.report-date-hint {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.report-date-value {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #07c160;
  white-space: nowrap;
}

.report-date-chevron {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
}

.report-date-bar picker {
  display: block;
  width: 100%;
}

.report-week-hint {
  display: block;
  padding-top: 8rpx;
}

.report-month-note,
.report-empty-hint {
  display: block;
  padding: 16rpx 32rpx 0;
  line-height: 1.5;
}

.report-chart-box {
  padding: 8rpx 8rpx 0;
  overflow: hidden;
}

.report-table-row--highlight {
  background: rgba(7, 193, 96, 0.08);
}

.report-table-row--highlight .ui-table-col--period,
.report-table-row--highlight .ui-table-col--wage {
  color: #07c160;
  font-weight: 600;
}
