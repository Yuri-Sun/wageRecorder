/**pages/report/report.wxss**/
@import '../../styles/ui-kit.wxss';

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

.report-scroll {
  flex: 1;
  height: 0;
}

.report-date-bar {
  background: #fff;
  padding: 16rpx 32rpx 12rpx;
  border-bottom: 1rpx solid #e6e6e6;
  flex-shrink: 0;
}

.report-date-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.report-date-hint {
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
}

.report-date-value {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #07c160;
}

.report-date-chevron {
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
}

.report-week-hint {
  display: block;
  padding-top: 8rpx;
}

.report-month-note,
.report-empty-hint {
  display: block;
  padding: 16rpx 32rpx 0;
  line-height: 1.5;
}

.report-chart-box {
  padding: 8rpx 8rpx 0;
  overflow: hidden;
}
