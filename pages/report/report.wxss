/**pages/report/report.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F5;
}

.scrollarea {
  flex: 1;
}

/* 总览卡片 */
.overview-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #FFFFFF;
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.overview-title {
  font-size: 28rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}

.overview-amount {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.overview-sub {
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

/* 图表 */
.chart-card {
  padding: 32rpx 24rpx;
}

.chart-scroll {
  width: 100%;
}

.chart-container {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  min-width: 100%;
  padding-top: 8rpx;
}

.bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  width: 100rpx;
}

.bar {
  width: 48rpx;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
  white-space: nowrap;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bar-value {
  font-size: 18rpx;
  color: #666666;
  font-weight: 500;
  white-space: nowrap;
}

/* 周模式：加宽柱状图以完整显示标签 */
.chart-week .bar-group {
  width: 160rpx;
}

.chart-week .bar-label {
  max-width: 160rpx;
}

/* 月模式 */
.chart-month .bar-group {
  width: 120rpx;
}

.chart-month .bar-label {
  max-width: 120rpx;
}

/* 详细列表 */
.stat-list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.stat-list-item:last-child {
  border-bottom: none;
}

.stat-list-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.stat-list-detail {
  display: block;
  margin-top: 4rpx;
}

.stat-list-wage {
  font-size: 30rpx;
  font-weight: 600;
  color: #07C160;
}
